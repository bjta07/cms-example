{
  "kind": "collectionType",
  "collectionName": "inscongresos",
  "info": {
    "singularName": "inscongreso",
    "pluralName": "inscongresos",
    "displayName": "Inscripciones Curso"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "apellidos": {
      "type": "string",
      "required": true
    },
    "CI": {
      "type": "string",
      "required": true
    },
    "telefono": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "departamento": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "La Paz",
        "Oruro",
        "Cochabamba",
        "Santa Cruz",
        "Potosí",
        "Chuquisaca",
        "Tarija",
        "Beni",
        "Pando"
      ]
    },
    "curso": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curso.curso",
      "inversedBy": "inscripciones"
    },
    "validacion": {
      "type": "enumeration",
      "required": true,
      "default": "Pendiente",
      "enum": [
        "Pendiente",
        "Validado",
        "Rechazado"
      ]
    },
    "CodCongreso": {
      "type": "uid",
      "required": true
    }
  }
}
