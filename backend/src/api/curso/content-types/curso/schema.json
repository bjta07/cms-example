{
  "kind": "collectionType",
  "collectionName": "cursos",
  "info": {
    "singularName": "curso",
    "pluralName": "cursos",
    "displayName": "curso"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "overlay": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "codigo": {
      "type": "uid",
      "targetField": "",
      "required": true
    },
    "inscripciones": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inscongreso.inscongreso",
      "mappedBy": "curso"
    },
    "activo": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
